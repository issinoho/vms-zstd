Subject: lib/zstd.h, zstd_errors.h, zdict.h: on OpenVMS, declare the API with the library's /NAMES

libzstd is compiled with /NAMES=(AS_IS,SHORTENED), as the OpenVMS family
of ports is: names keep their case, and those longer than 31 characters
(ZSTD_compressStream2_simpleArgs ...) are shortened the same way
everywhere.  A program compiled with VSI C's default /NAMES=UPPERCASE would
look for ZSTD_VERSIONSTRING and not find ZSTD_versionString.  Declare the
API under #pragma names as_is, shortened on VMS, so programs compiled with
any /NAMES link with the library (as vms-zlib, vms-bzip2 and vms-xz do).

--- a/lib/zstd.h	2025-02-19 00:04:24.000000000 +0000
+++ b/lib/zstd.h	2026-10-05 12:49:18.447804258 +0100
@@ -20,6 +20,12 @@
 #include <limits.h>   /* INT_MAX */
 #endif /* ZSTD_STATIC_LINKING_ONLY */
 
+#ifdef __VMS
+/* The library is compiled with /NAMES=(AS_IS,SHORTENED); declare its API
+   so, whatever /NAMES the program is compiled with.  */
+#  pragma names save
+#  pragma names as_is, shortened
+#endif
 #if defined (__cplusplus)
 extern "C" {
 #endif
@@ -1213,6 +1219,9 @@
 #if defined (__cplusplus)
 }
 #endif
+#ifdef __VMS
+#  pragma names restore
+#endif
 
 #endif  /* ZSTD_H_235446 */
 
@@ -1229,6 +1238,12 @@
 #if defined(ZSTD_STATIC_LINKING_ONLY) && !defined(ZSTD_H_ZSTD_STATIC_LINKING_ONLY)
 #define ZSTD_H_ZSTD_STATIC_LINKING_ONLY
 
+#ifdef __VMS
+/* The library is compiled with /NAMES=(AS_IS,SHORTENED); declare its API
+   so, whatever /NAMES the program is compiled with.  */
+#  pragma names save
+#  pragma names as_is, shortened
+#endif
 #if defined (__cplusplus)
 extern "C" {
 #endif
@@ -3194,5 +3209,8 @@
 #if defined (__cplusplus)
 }
 #endif
+#ifdef __VMS
+#  pragma names restore
+#endif
 
 #endif   /* ZSTD_H_ZSTD_STATIC_LINKING_ONLY */
